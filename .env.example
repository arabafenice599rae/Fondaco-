# Copy to .env (git-ignored). Never commit real keys.

# Archive-capable mainnet RPC used ONLY to fork mainnet locally with anvil (read-only).
MAINNET_RPC_URL=https://eth.drpc.org

# Public Base RPC, read-only: verify-source compares the AirSwap deployment on Base (default https://mainnet.base.org).
# BASE_RPC_URL=https://mainnet.base.org

# Local fork endpoint the suites talk to (started by tools/testkit/run-suites.mjs).
FORK_URL=http://127.0.0.1:8545

# Deploy (packages/contracts/scripts/deploy.js). Leave empty in development.
# RPC_URL=
# PRIVATE_KEY=
# FEE_BPS=30
# FEE_WALLET=
# OWNER=
