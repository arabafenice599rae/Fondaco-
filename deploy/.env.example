# Copy to deploy/.env (git-ignored). Never commit real credentials.
DOMAIN=book.example.org
BOOK_VERSION=v0.1.0        # the image tag is the git tag of the release (D-56)
# BOOK_IMAGE=ghcr.io/arabafenice599rae/fondaco-book
# S3-compatible storage for the hourly backups (bucket created beforehand, credentials limited to that bucket)
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=fondaco-book-backups
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BACKUP_EVERY_SEC=3600
# BACKUP_KEEP=168
