{
  "name": "@fondaco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FONDACO web app: static build (Vite), no server process, no API keys",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "DEMO=true vite build --outDir dist-demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --no-warnings test/model.test.mjs",
    "test:keys": "node scripts/scan-keys.mjs",
    "test:e2e": "node --no-warnings test/e2e.mjs",
    "test:visual": "node --no-warnings test/visual.mjs",
    "test:visual:update": "node --no-warnings test/visual.mjs --update"
  },
  "dependencies": {
    "@fondaco/client": "workspace:*",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "geist": "1.8.1",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
