{
  "name": "@fondaco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FONDACO web app: static build (Vite), no server process, no API keys",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "DEMO=true vite build --outDir dist-demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --no-warnings test/model.test.mjs",
    "test:keys": "node scripts/scan-keys.mjs",
    "test:e2e": "node --no-warnings test/e2e.mjs"
  },
  "dependencies": { "@fondaco/client": "workspace:*", "viem": "2.57.13" },
  "devDependencies": { "geist": "1.8.1", "vite": "8.3.5" },
  "license": "MIT"
}
