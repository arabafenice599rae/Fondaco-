{
  "name": "fondaco",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @fondaco/contracts build",
    "typecheck": "pnpm --filter @fondaco/contracts typecheck",
    "check:abi": "pnpm --filter @fondaco/contracts check:abi",
    "verify-source": "node tools/verify-source/verify-source.mjs",
    "test:verify-source": "node tools/verify-source/verify-source.test.mjs",
    "test:unit": "pnpm --filter @fondaco/client test:wallet",
    "test:fork": "node tools/testkit/run-fork-suites.mjs",
    "test": "pnpm build && pnpm check:abi && pnpm test:unit && pnpm test:verify-source && pnpm test:fork"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
