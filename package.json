{
  "name": "fondaco",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:generated": "pnpm --filter @fondaco/contracts check:abi && pnpm --filter @fondaco/book-server check:config-doc",
    "verify-source": "node tools/verify-source/verify-source.mjs",
    "test:unit": "node tools/testkit/run-suites.mjs --unit",
    "test:fork": "node tools/testkit/run-suites.mjs --fork",
    "test": "pnpm build && pnpm typecheck && pnpm check:generated && node tools/testkit/run-suites.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
